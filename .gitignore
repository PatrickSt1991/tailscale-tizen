# Cross-compiled binaries staged for packaging
/tailscaled-arm
/tailscale-cli-arm

# Local environment overrides (cert passwords, etc.)
.env.local

# .NET build artifacts
**/bin/
**/obj/

# Tailscale staged binaries (cross-compiled into lib/ at build time)
/Tailscale/lib/tailscaled
/Tailscale/lib/tailscale

# Tizen 5.0 port: tailscaled staged into shared/res at build time (see csproj)
/Tailscale5/shared/res/tailscaled

# c-shared spike build outputs (engine + control libs), staged into
# Tailscale5/shared/res and Tailscale5/lib by CI before the dotnet build
/cshared/*.so
/cshared/*.h
/Tailscale5/shared/res/libtsspike.so
/Tailscale5/shared/res/libhello_*.so
/Tailscale5/lib/

# Signed packages
*.signed.tpk
DotnetProbe.signed.tpk
Tailscale.signed.tpk
